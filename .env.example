# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=fastfood
POSTGRES_PASSWORD=fastfood
POSTGRES_DB=fastfood_db

# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI) Configuration
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fastfood:fastfood@postgres:5432/fastfood_db
SECRET_KEY=your-super-secret-key-change-in-production
PYTHONUNBUFFERED=1

# ─────────────────────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# MercadoPago Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Frontend: Public Key for React SDK
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend: Access Token for API interactions
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret_aqui
NGROK_URL=url_de_ngrok

# URL base del frontend para redirecciones (puerto 80 para docker, 5173 si lo corres manual)
FRONTEND_URL=http://localhost

